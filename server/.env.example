# --- Readoft API: Example environment file ---
# Copy this to server/.env and fill in values.

# --- Core server ---
PORT=4000
JWT_SECRET=change-me-please
# Comma-separated list of allowed web origins (for CORS)
# e.g. in local prod behind Nginx: http://localhost:8080
CORS_ORIGIN=http://localhost:8080

# Base URL used to build absolute links (RSS, sitemap, emails)
# Set to your public site origin in production, e.g. https://readoft.example.com
PUBLIC_BASE_URL=http://localhost:8080
# Optionally used by some routes if PUBLIC_BASE_URL not set
APP_BASE_URL=

# --- Supabase ---
SUPABASE_URL=
# Prefer using the service role key on the server (fallback to anon if needed)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# --- Email / SMTP ---
# SMTP connection URL, e.g. smtp://user:pass@smtp.example.com:587
SMTP_URL=
# or legacy naming used by some platforms
NODEMAILER_URL=
EMAIL_FROM="Readoft <no-reply@yourdomain.com>"

# --- Web Push (optional) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@yourdomain.com

# --- AI (optional) ---
# Google Gemini API key for /api/ai/summarize
GEMINI_API_KEY=
